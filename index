/* إعدادات عامة */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Arial', sans-serif;
}

body {
  background: linear-gradient(to right, #4facfe, #00f2fe);
  color: #fff;
  text-align: center;
  padding: 20px;
}

/* رأس الصفحة */
header {
  padding: 50px 20px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 15px;
  margin-bottom: 40px;
  box-shadow: 0 0 15px rgba(0,0,0,0.3);
}

header h1 {
  font-size: 3em;
  margin-bottom: 10px;
}

header p {
  font-size: 1.2em;
}

/* المحتوى */
.content {
  display: flex;
  justify-content: center;
  gap: 30px;
  flex-wrap: wrap;
}

.card {
  background: #fff;
  color: #333;
  padding: 30px;
  border-radius: 15px;
  width: 250px;
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  transition: transform 0.3s, box-shadow 0.3s;
}

.card:hover {
  transform: translateY(-10px);
  box-shadow: 0 15px 30px rgba(0,0,0,0.3);
}

.card h2 {
  margin-bottom: 10px;
}

